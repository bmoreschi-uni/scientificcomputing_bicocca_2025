Cell["I find numerical solutions with FindRoot:", "Text",
 CellChangeTimes->{{4.00112797278303*^9, 
  4.001127988071698*^9}},ExpressionUUID->"35cbb572-083f-4ff8-94a2-\
267821f41860"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FindRoot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"x", " ", 
      RowBox[{"Log", "[", "x", "]"}]}], "-", 
     RowBox[{"3", " ", "x"}], "+", "10"}], "\[Equal]", "6"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "1.5"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{4.001123713293058*^9},
