Notebook[{

Cell[CellGroupData[{
Cell["L5 - Symbolic maths: Mathematica", "Title",
 CellChangeTimes->{{4.0011277806972647`*^9, 4.001127787036434*^9}, 
   4.001138908781865*^9, {4.001139221035049*^9, 
   4.0011392299361267`*^9}},ExpressionUUID->"2ee9e7aa-16a7-46b0-9fca-\
e162c715e4c0"],

Cell[CellGroupData[{

Cell["\<\
Q3: Solve the equation  x ln(x) - 3 x + 10 = 6, both symbolically and \
numerically.\
\>", "Subsection",
 CellChangeTimes->{
  4.0011277514519997`*^9},ExpressionUUID->"1d1e4fb1-e936-4fbc-a1b7-\
006356bb716e"],

Cell["Symbolical solutions using Solve are:", "Text",
 CellChangeTimes->{{4.00112803287961*^9, 4.001128037473837*^9}, {
  4.0011280871663933`*^9, 
  4.001128090097822*^9}},ExpressionUUID->"65b03465-dcf1-4d67-a29e-\
1dcb8fcf33dc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sol", "=", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"x", " ", 
       RowBox[{"Log", "[", "x", "]"}]}], "-", 
      RowBox[{"3", " ", "x"}], "+", "10"}], "\[Equal]", "6"}], ",", "x"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{4.001128854093556*^9, 4.001128858572706*^9}, {
  4.001138991929903*^9, 4.0011389922988787`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"c4cacefb-aca4-4081-9d93-6fb41eaa099b"],

Cell[BoxData[
 TemplateBox[{
  "Solve", "ifun", 
   "\"Inverse functions are being used by \
\\!\\(\\*RowBox[{\\\"Solve\\\"}]\\), so some solutions may not be found; use \
Reduce for complete solution information.\"", 2, 1, 1, 30290698187318321713, 
   "Local"},
  "MessageTemplate",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{
  4.001123735037241*^9, {4.0011389663019533`*^9, 4.001138993604033*^9}, 
   4.001160062955751*^9},
 CellLabel->
  "During evaluation of \
In[1]:=",ExpressionUUID->"e1ef1c28-6ba9-4b6f-b722-ce7cbc774799"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", 
     RowBox[{"-", 
      FractionBox["4", 
       RowBox[{"ProductLog", "[", 
        RowBox[{"-", 
         FractionBox["4", 
          SuperscriptBox["\[ExponentialE]", "3"]]}], "]"}]]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", 
     RowBox[{"-", 
      FractionBox["4", 
       RowBox[{"ProductLog", "[", 
        RowBox[{
         RowBox[{"-", "1"}], ",", 
         RowBox[{"-", 
          FractionBox["4", 
           SuperscriptBox["\[ExponentialE]", "3"]]}]}], "]"}]]}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{
  4.0011237350484877`*^9, {4.001138966316636*^9, 4.001138993616838*^9}, 
   4.001160062968733*^9},
 CellLabel->"Out[1]=",ExpressionUUID->"ddf46a14-e5d4-476d-b719-c42b3ef41af4"]
}, Open  ]],

Cell["So the two solutions are:", "Text",
 CellChangeTimes->{{4.001127672434238*^9, 4.001127681434761*^9}, {
  4.001128415225041*^9, 4.001128419655648*^9}, {4.001138977729188*^9, 
  4.001138981268045*^9}},ExpressionUUID->"ceaced84-1695-4dd4-9ea8-\
6343ba256627"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"N", "[", "sol", "]"}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"994f4610-cefd-4294-8ed1-a049fe5562a2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", "15.522896611261864`"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", "1.5688309034084709`"}], "}"}]}], "}"}]], "Output",\

 CellChangeTimes->{4.0011389835861197`*^9, 4.0011600683340597`*^9},
 CellLabel->"Out[2]=",ExpressionUUID->"b81e11c9-8266-4981-a748-735d518af97a"]
}, Open  ]],

Cell["\<\
I plot the function between 0.1 and 20 to have another guess of the x values \
to put in FindRoot:\
\>", "Text",
 CellChangeTimes->{{4.001127827416697*^9, 4.001127843153425*^9}, {
  4.00112789843437*^9, 4.001127916251307*^9}, {4.001128000582704*^9, 
