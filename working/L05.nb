Cell["Solve and FindRoot give the same two roots.", "Text",
 CellChangeTimes->{{4.001128073117221*^9, 
  4.00112807400793*^9}},ExpressionUUID->"8db4c607-c5ed-4351-a3b2-\
66bc58094941"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Q4: Solve the following initial-value problem using both DSolve and \
NDSolve. Compare your answers by plotting them.\ny\[CloseCurlyQuote]\
\[CloseCurlyQuote](x) - x y(x) = 0\ny(0) = 1\ny\[CloseCurlyQuote](0) = - ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["3", 
     RowBox[{"1", "/", "3"}]], 
    RowBox[{
     RowBox[{"Gamma", "(", 
      RowBox[{"2", "/", "3"}], ")"}], "/", 
     RowBox[{"Gamma", "(", 
      RowBox[{"1", "/", "3"}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "8375e221-2fc7-4bea-820f-666ce9007e7f"],
 "\n(bonus: solve it with scipy and check result and speed).  "
}], "Subsection",
 CellChangeTimes->{
  4.0011281355235367`*^9},ExpressionUUID->"87dd7705-9deb-4677-90b1-\
48e52bf5882e"],

Cell["Using DSolve:", "Text",
 CellChangeTimes->{{4.001128176903243*^9, 
  4.0011281823328953`*^9}},ExpressionUUID->"7436405e-dbf5-44c5-af3b-\
6c25c0357964"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"ds", " ", "=", " ", 
  RowBox[{"DSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"y", "''"}], "[", "x", "]"}], "-", 
        RowBox[{"x", " ", 
         RowBox[{"y", "[", "x", "]"}]}]}], "\[Equal]", "0"}], ",", 
      RowBox[{
       RowBox[{"y", "[", "0", "]"}], "\[Equal]", "1"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"y", "'"}], "[", "0", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["3", 
          RowBox[{"1", "/", "3"}]]}], 
        FractionBox[
         RowBox[{"Gamma", "[", 
          RowBox[{"2", "/", "3"}], "]"}], 
         RowBox[{"Gamma", "[", 
          RowBox[{"1", "/", "3"}], "]"}]]}]}]}], "}"}], ",", "y", ",", "x"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"plot1", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"y", "/.", " ", 
     RowBox[{"Flatten", "@", "ds"}]}], ")"}], "[", "x", "]"}]}]}], "Input",
 CellChangeTimes->{{4.001126360512673*^9, 4.001126395555517*^9}, {
  4.001126452762885*^9, 4.001126455469503*^9}, {4.0011267113872213`*^9, 
  4.0011267179380713`*^9}, {4.001126855517456*^9, 4.001126876611951*^9}, {
  4.0011287072896*^9, 4.001128757658119*^9}, {4.001128806517145*^9, 
  4.0011288266401567`*^9}, {4.0011289003184013`*^9, 4.001128983531081*^9}, {
  4.001129022219103*^9, 4.001129032148119*^9}, {4.001160057402295*^9, 
  4.001160058899909*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"b355f01b-2224-4d99-ad7c-2aca6cb3bbef"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"y", "\[Rule]", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", "x", "}"}], ",", 
      RowBox[{
       SuperscriptBox["3", 
        RowBox[{"2", "/", "3"}]], " ", 
       RowBox[{"AiryAi", "[", "x", "]"}], " ", 
       RowBox[{"Gamma", "[", 
        FractionBox["2", "3"], "]"}]}]}], "]"}]}], "}"}], "}"}]], "Output",
