Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"x", "\[Rule]", "1.5688309034084709`"}], "}"}]], "Output",
 CellChangeTimes->{4.0011237157354927`*^9, 4.0011600737801533`*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"378f2981-8a1f-48e7-bbe3-b7b3115a0723"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FindRoot", "[", 
